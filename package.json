{
  "name": "iceberg-pm",
  "version": "1.0.0",
  "private": true,
  "description": "Dev-focused project management platform",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "convex": "^1.13.0",
    "prettier": "^3.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@8.12.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@clerk/backend": "^2.5.0",
    "svix": "^1.15.0"
  }
}
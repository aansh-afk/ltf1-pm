{
  "name": "iceberg-pm",
  "version": "1.0.0",
  "private": true,
  "description": "Dev-focused project management platform",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.9",
    "prettier": "^3.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@8.12.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@clerk/backend": "^2.5.0",
    "@octokit/app": "^16.0.1",
    "@octokit/rest": "^22.0.0",
    "@octokit/webhooks": "^14.1.3",
    "convex": "^1.13.0",
    "jsonwebtoken": "^9.0.2",
    "svix": "^1.15.0"
  }
}
{
  "name": "@iceberg/cli",
  "version": "0.1.0",
  "description": "LTF CLI - Terminal interface for iceberg project management",
  "type": "module",
  "bin": {
    "ltf": "./dist/bin/ltf.js"
  },
  "scripts": {
    "dev": "TSX_DEV=1 tsx watch src/bin/ltf.ts",
    "build": "tsup src/bin/ltf.ts --format esm --outDir dist/bin --clean --loader '.tsx=tsx' && tsup src/index.ts --format esm --outDir dist --dts",
    "start": "node dist/bin/ltf.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "link": "pnpm build && npm link"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "conf": "^13.0.1",
    "convex": "^1.13.0",
    "inquirer": "^10.2.2",
    "open": "^10.1.0",
    "ora": "^8.1.1",
    "boxen": "^8.0.1",
    "figures": "^6.1.0",
    "chokidar": "^4.0.1",
    "date-fns": "^4.1.0",
    "express": "^4.21.0",
    "simple-git": "^3.27.0",
    "ink": "^5.0.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.19.9",
    "@types/react": "^18.3.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cli",
    "project-management",
    "task-management",
    "git"
  ],
  "author": "Iceberg Team",
  "license": "MIT"
}

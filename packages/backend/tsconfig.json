{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "../../convex/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]

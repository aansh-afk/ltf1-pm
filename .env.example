# GitLab Integration
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:3000/api/gitlab/callback

# GitHub App (see docs/GITHUB_SETUP.md for full guide)
GITHUB_APP_ID=
VITE_GITHUB_APP_SLUG=
VITE_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
